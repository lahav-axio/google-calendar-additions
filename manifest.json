{
    "name": "__MSG_appName__",
    "description": "__MSG_appDesc__",
    "default_locale": "en",
    "version": "2.5.0",
    "content_scripts": [
        {
            "matches": ["https://www.google.com/calendar/*", "https://calendar.google.com/calendar/*"],
            "js": ["chroma.min.js", "events.user.js", "drag-edit.js"],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "permissions": ["storage", "identity"],
    "host_permissions": ["https://www.google.com/calendar/*", "https://calendar.google.com/*", "https://www.googleapis.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Cal Merge + My Calendar",
        "default_popup": "index.html"
    },
    "icons": {
        "48": "icon.png"
    },
    "content_security_policy": { "default-src": "self" },
    "manifest_version": 3
}
